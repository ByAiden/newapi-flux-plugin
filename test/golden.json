{
  "cases": [
    {
      "name": "openai image submits the mapped FLUX.2 model with x-key",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "requestBody": {
            "prompt": "A cat",
            "width": 1536,
            "height": 1024,
            "seed": 3,
            "model": "cat"
          },
          "requestHeaders": {
            "Content-Type": "application/json",
            "Accept": ""
          },
          "action": "text_to_image",
          "model": "cat",
          "upstreamModel": "flux-2-pro",
          "baseUrl": "https://api.bfl.ai",
          "apiKey": "test-key",
          "authHeader": "Bearer test-key",
          "upstream": {
            "kind": "vendor"
          },
          "config": {},
          "files": [],
          "publicTaskId": "task_public"
        }
      ],
      "expected": {
        "url": "https://api.bfl.ai/v1/flux-2-pro",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "x-key": "test-key"
        },
        "body": {
          "prompt": "A cat",
          "width": 1536,
          "height": 1024,
          "seed": 3
        },
        "action": "text_to_image"
      }
    },
