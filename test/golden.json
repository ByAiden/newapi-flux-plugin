          "config": {},
          "files": [],
          "publicTaskId": "task_public"
        },
        {
          "statusCode": 200,
          "headers": {},
          "body": {
            "id": "bfl-1",
            "polling_url": "https://api.us1.bfl.ai/v1/get_result?id=bfl-1",
            "cost": 4.5,
            "input_mp": 0,
            "output_mp": 1.5
          }
        }
      ],
      "expected": {
        "taskId": "bfl-1",
        "taskData": {
          "id": "bfl-1",
          "polling_url": "https://api.us1.bfl.ai/v1/get_result?id=bfl-1",
          "cost": 4.5,
          "input_mp": 0,
          "output_mp": 1.5
        },
        "state": {
          "model": "flux-2-pro",
          "refs": 0,
          "reserved": {
            "credits": 4.5,
            "output_megapixels": 2,
            "input_megapixels": 0,
            "image_count": 1
          },
          "polling_url": "https://api.us1.bfl.ai/v1/get_result?id=bfl-1",
